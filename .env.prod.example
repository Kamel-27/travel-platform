# Copy to `.env` in the repo root on the VM (docker-compose reads it automatically
# for the ${...} substitutions in docker-compose.prod.yml). Not the same file as
# app/Backend/.env — that one holds the backend's own app-level config.

# Postgres password (pick a strong one, only used inside the docker network)
POSTGRES_PASSWORD=change-me

# The domain Caddy requests a TLS cert for and reverse-proxies to the backend.
# No domain yet? Use https://sslip.io — e.g. "203-0-113-10.sslip.io" resolves
# to 203.0.113.10 with zero DNS setup, and Let's Encrypt issues real certs for it.
DOMAIN=api.example.com
