NODE_ENV=development
PORT=3001

# Matches docker-compose.yml at the repo root
DATABASE_URL=postgresql://travelhub:travelhub@localhost:5432/travelhub
REDIS_URL=redis://localhost:6379

# Auth (feat/auth-core)
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
WEB_APP_URL=http://localhost:3000
# Transactional email (feat/real-email)
# Leave RESEND_API_KEY empty in dev — magic links are logged to the console.
# In production, verify the sending domain on Resend, then set both:
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
#   MAIL_FROM=Safariyat <no-reply@auth.safariyat.live>
RESEND_API_KEY=
MAIL_FROM=Safariyat <no-reply@auth.safariyat.live>

# Auth (feat/auth-google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
# Flight Search (feat/flights-search)
DUFFEL_API_KEY=
# Schedule-change/order webhooks (feat/schedule-change-handling)
DUFFEL_WEBHOOK_SECRET=

# Payments (feat/payments-paymob)
PAYMOB_API_BASE=https://accept.paymob.com/api
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Error reporting (chore/production-hardening)
# Leave SENTRY_DSN empty in dev and CI — every Sentry call becomes a no-op.
# In production set it to the DSN from your Sentry project settings.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
