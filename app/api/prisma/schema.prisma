// =============================================================
// Travel Platform — Prisma Schema
// B2B Travel Platform with PKFARE Integration
// =============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  AGENT
  FINANCE
}

enum WalletTransactionType {
  DEPOSIT
  BOOKING_DEBIT
  REFUND_CREDIT
  ADJUSTMENT
  BONUS_CREDIT
  WITHDRAWAL
}

enum BookingType {
  FLIGHT
  HOTEL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  TICKETED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  FAILED
  EXPIRED
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

enum MarkupType {
  PERCENTAGE
  FIXED
}

enum ServiceType {
  FLIGHT
  HOTEL
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  ADMIN_ADJUSTMENT
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

/// Travel agency / company registered on the platform
model Company {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @db.VarChar(255)
  nameAr            String?       @db.VarChar(255)
  licenseNumber     String        @unique @db.VarChar(100)
  country           String        @db.VarChar(100)
  city              String        @db.VarChar(100)
  address           String?       @db.Text
  phone             String        @db.VarChar(50)
  email             String        @unique @db.VarChar(255)
  logo              String?       @db.Text
  website           String?       @db.VarChar(255)
  status            CompanyStatus @default(PENDING)
  markupPercentage  Decimal       @default(0) @db.Decimal(5, 2)
  contactPersonName String?       @db.VarChar(255)
  contactPersonPhone String?      @db.VarChar(50)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  users        User[]
  wallets      Wallet[]
  bookings     Booking[]
  invoices     Invoice[]
  markupRules  MarkupRule[]

  @@index([status])
  @@index([country])
  @@map("companies")
}

/// Platform user (belongs to a company or is super admin)
model User {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String?   @db.Uuid
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @db.Text
  fullName         String    @db.VarChar(255)
  fullNameAr       String?   @db.VarChar(255)
  phone            String?   @db.VarChar(50)
  role             UserRole  @default(AGENT)
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?   @db.Text
  lastLoginAt      DateTime?
  lastLoginIp      String?   @db.VarChar(45)
  refreshTokenHash String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  auditLogs AuditLog[]

  @@index([companyId])
  @@index([role])
  @@map("users")
}

/// Company wallet for prepaid credit
model Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @unique @db.Uuid
  balance     Decimal  @default(0) @db.Decimal(15, 2)
  currency    String   @default("SAR") @db.VarChar(3)
  creditLimit Decimal  @default(0) @db.Decimal(15, 2)
  isActive    Boolean  @default(true)
  version     Int      @default(0) // Optimistic locking
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

/// Individual wallet transaction (double-entry ledger)
model WalletTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  walletId       String                @db.Uuid
  bookingId      String?               @db.Uuid
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(15, 2)
  balanceBefore  Decimal               @db.Decimal(15, 2)
  balanceAfter   Decimal               @db.Decimal(15, 2)
  currency       String                @default("SAR") @db.VarChar(3)
  reference      String?               @db.VarChar(255)
  description    String?               @db.Text
  idempotencyKey String                @unique @db.VarChar(255)
  metadata       Json?
  createdAt      DateTime              @default(now())

  wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([bookingId])
  @@index([type])
  @@map("wallet_transactions")
}

/// Deposit request from a company
model DepositRequest {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @db.Uuid
  amount        Decimal       @db.Decimal(15, 2)
  bonusAmount   Decimal       @default(0) @db.Decimal(15, 2)
  currency      String        @default("SAR") @db.VarChar(3)
  paymentMethod PaymentMethod
  reference     String?       @db.VarChar(255)
  proofUrl      String?       @db.Text
  status        DepositStatus @default(PENDING)
  approvedBy    String?       @db.Uuid
  approvedAt    DateTime?
  rejectedReason String?      @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([companyId, status])
  @@map("deposit_requests")
}

/// Flight or hotel booking
model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  userId          String        @db.Uuid
  type            BookingType
  status          BookingStatus @default(PENDING)
  pkfareOrderId   String?       @db.VarChar(255)
  pnr             String?       @db.VarChar(50)
  searchParams    Json?
  pkfareResponse  Json?
  supplierPrice   Decimal       @db.Decimal(15, 2)
  markupAmount    Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal       @db.Decimal(15, 2)
  currency        String        @default("SAR") @db.VarChar(3)
  contactEmail    String?       @db.VarChar(255)
  contactPhone    String?       @db.VarChar(50)
  specialRequests String?       @db.Text
  ticketDeadline  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company           Company              @relation(fields: [companyId], references: [id])
  user              User                 @relation(fields: [userId], references: [id])
  passengers        Passenger[]
  invoice           Invoice?
  statusLogs        BookingStatusLog[]
  walletTransactions WalletTransaction[]

  @@index([companyId, status])
  @@index([userId])
  @@index([pkfareOrderId])
  @@index([pnr])
  @@index([createdAt])
  @@map("bookings")
}

/// Passenger details for a booking
model Passenger {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @db.Uuid
  type            PassengerType @default(ADULT)
  title           String?       @db.VarChar(10)
  firstName       String        @db.VarChar(255)
  lastName        String        @db.VarChar(255)
  dateOfBirth     DateTime      @db.Date
  nationality     String        @db.VarChar(3)
  passportNumber  String?       @db.VarChar(50)
  passportExpiry  DateTime?     @db.Date
  passportCountry String?       @db.VarChar(3)
  ticketNumber    String?       @db.VarChar(50)
  seatPreference  String?       @db.VarChar(50)
  mealPreference  String?       @db.VarChar(50)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("passengers")
}

/// Invoice generated for a booking
model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  bookingId     String   @unique @db.Uuid
  companyId     String   @db.Uuid
  invoiceNumber String   @unique @db.VarChar(50)
  subtotal      Decimal  @db.Decimal(15, 2)
  tax           Decimal  @default(0) @db.Decimal(15, 2)
  total         Decimal  @db.Decimal(15, 2)
  currency      String   @default("SAR") @db.VarChar(3)
  pdfUrl        String?  @db.Text
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([invoiceNumber])
  @@map("invoices")
}

/// Booking status change log
model BookingStatusLog {
  id         String        @id @default(uuid()) @db.Uuid
  bookingId  String        @db.Uuid
  fromStatus BookingStatus?
  toStatus   BookingStatus
  note       String?       @db.Text
  changedBy  String?       @db.Uuid
  createdAt  DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_logs")
}

/// Markup rules (per company or global)
model MarkupRule {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String?     @db.Uuid
  serviceType ServiceType
  markupType  MarkupType  @default(PERCENTAGE)
  markupValue Decimal     @db.Decimal(10, 2)
  minMarkup   Decimal?    @db.Decimal(10, 2)
  maxMarkup   Decimal?    @db.Decimal(10, 2)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, serviceType])
  @@map("markup_rules")
}

/// Audit log for all critical actions
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @db.Uuid
  changes   Json?
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
